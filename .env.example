# Copy to .env.local for local development. Never commit real values.

# Browser (public by design; Row Level Security protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel environment variables, used by api/invite-user.js).
# NEVER prefix with VITE_ — that would ship it to every browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: run the workbook reconciliation tests (file is never committed)
# PASTI_WORKBOOK=C:\path\to\PASTI_Asset_Code_Registerv2.xlsx
